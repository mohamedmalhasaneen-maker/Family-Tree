rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['name', 'parentId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'parentId', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.parentId is string && data.parentId.size() <= 128 &&
             (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    match /members/{memberId} {
      // Family tree viewable and manageable by all family members without login
      allow read: if true;

      // Creation validated against schema
      allow create: if isValidId(memberId) &&
                       isValidMember(incoming());

      // Update preserves createdAt and modifies allowed fields
      allow update: if isValidId(memberId) &&
                       isValidMember(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'parentId', 'updatedAt']);

      // Deletion of member
      allow delete: if isValidId(memberId);
    }
  }
}
